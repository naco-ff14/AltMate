<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.62.16</Version>
    <AssemblyName>AltMate</AssemblyName>
    <RootNamespace>AltMate</RootNamespace>
    <Description>Multi-character linking, housing, animation, and gil management for FFXIV.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="AltMate.SyncAgent/**/*.cs;AltMate.SyncContracts/**/*.cs" />
    <!-- Share the tested transport/exporter without embedding the console entry point. -->
    <Compile Include="AltMate.SyncAgent/Exporter.cs;AltMate.SyncAgent/SecureStore.cs;AltMate.SyncAgent/SyncTransport.cs;AltMate.SyncContracts/SyncEnvelope.cs" />
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NoireLib" Version="2.0.0.0" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
</Project>
